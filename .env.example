# Copiez ce fichier en « .env » pour un essai sur votre ordinateur.
# Sur Render, ces valeurs se saisissent dans l'onglet « Environment » du service (jamais dans le code).

# --- IA (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Données de matchs (football-data.org, offre gratuite) ---
FOOTBALL_DATA_API_KEY=

# --- Facultatif ---
# SPORTSDB_API_KEY=            # clé payante TheSportsDB (la clé gratuite ne renvoie que 15 matchs par saison)
# ALLOWED_ORIGINS=https://mon-domaine.example   # s'ajoute aux adresses autorisées par défaut
# AI_DAILY_BUDGET_CALLS=400
# AI_MAX_PARALLEL=6            # appels à l'IA en même temps (1 à 12)
# PICK_MAX_PROBABILITY=        # plafond de probabilité des paris choisis automatiquement (ex. 0.9 ou 90 %) ; absent = aucun plafond

# --- Ouverture à tous les matchs (tout est activé par défaut ; « off » coupe sans redéployer le code) ---
# EUROPE_ENABLED=off           # coupes d'Europe + comparaison entre clubs de championnats différents
# EXTRA_LEAGUES_ENABLED=off    # 20 championnats complémentaires (2es divisions, Turquie, Grèce…)
# TOP_CUPS=off                 # « Top Matchs » ne retient pas de match de coupe d'Europe
# EUROPE_HALF_LIFE_DAYS=365    # mémoire des matchs de coupe pour comparer les championnats (60 à 1500)
