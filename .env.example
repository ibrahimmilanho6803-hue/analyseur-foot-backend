# Copiez ce fichier en « .env » pour un essai sur votre ordinateur.
# Sur Render, ces valeurs se saisissent dans l'onglet « Environment » du service (jamais dans le code).

# --- IA (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Données de matchs (football-data.org, offre gratuite) ---
FOOTBALL_DATA_API_KEY=

# --- Facultatif ---
# SPORTSDB_API_KEY=            # clé payante TheSportsDB (la clé gratuite ne renvoie que 15 matchs par saison)
# ALLOWED_ORIGINS=https://mon-domaine.example   # s'ajoute aux adresses autorisées par défaut
# AI_DAILY_BUDGET_CALLS=400
# TOP_TARGET_ODDS=2.5
